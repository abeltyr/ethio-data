---
interface Props {
  title?: string;
}
const { title = "Ethiopia Economic Data" } = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <style>
      :root { color-scheme: light dark; --fg: #1a1a1a; --muted: #666; --accent: #0a6; --bg: #fff; }
      @media (prefers-color-scheme: dark) { :root { --fg: #e8e8e8; --muted: #9a9a9a; --bg: #141414; } }
      * { box-sizing: border-box; }
      body { margin: 0; font: 16px/1.65 ui-sans-serif, system-ui, -apple-system, sans-serif; color: var(--fg); background: var(--bg); }
      header { border-bottom: 1px solid color-mix(in srgb, var(--fg) 12%, transparent); padding: 1rem 1.25rem; }
      header a { font-weight: 700; text-decoration: none; color: var(--fg); }
      main { max-width: 820px; margin: 0 auto; padding: 1.5rem 1.25rem 4rem; }
      a { color: var(--accent); }
      article :is(h1, h2, h3) { line-height: 1.25; margin-top: 2rem; }
      article table { border-collapse: collapse; width: 100%; display: block; overflow-x: auto; }
      article th, article td { border: 1px solid color-mix(in srgb, var(--fg) 15%, transparent); padding: 6px 10px; text-align: left; }
      article code { background: color-mix(in srgb, var(--fg) 8%, transparent); padding: 1px 5px; border-radius: 4px; }
      article pre { background: color-mix(in srgb, var(--fg) 6%, transparent); padding: 12px; overflow-x: auto; border-radius: 8px; }
      .muted { color: var(--muted); }
    </style>
  </head>
  <body>
    <header><a href="/">📊 Ethiopia Economic Data</a></header>
    <main><slot /></main>
  </body>
</html>
