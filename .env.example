START_DATE=2023-01-30
END_DATE=2024-01-30
DB_PATH=exchange_rates.db
LOG_FILE=failed_dates.log

PROVIDER_ID=nbe
PROVIDER_TASK=daily

RATE_LIMIT_MS=500
MAX_RETRIES=2
RETRY_DELAY_MS=2000
# Per-attempt HTTP timeout (ms). A host that accepts the connection but never replies
# is aborted after this instead of hanging the whole run. Lower it (e.g. 10000) to fail
# flaky banks faster during a long backfill.
FETCH_TIMEOUT_MS=30000
# Opt-in: collect from hosts with a broken TLS chain (e.g. Hibret). Public read-only only.
# ALLOW_INSECURE_TLS=1
